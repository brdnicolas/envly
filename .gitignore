# Dependencies (every app keeps its own node_modules, see installConfig.hoistingLimits)
node_modules/
.pnp
.pnp.*

# Yarn 4: commit the pinned release, ignore the rest
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# Builds & caches
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Secrets — never commit (see docs/deployment.md for the variables)
.env
.env*
!.env.example

# Vercel
.vercel

# Brand script previews
scripts/brand/preview-*.png

# OS / editors
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
yarn-debug.log*
yarn-error.log*
.p