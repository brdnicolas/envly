generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model User {
  id                String                   @id @default(cuid())
  name              String?
  email             String?                  @unique
  emailVerified     DateTime?
  image             String?
  description       String?
  password          String?
  slug              String?                  @unique
  accounts          Account[]
  sessions          Session[]
  collections       Collection[]
  followers         UserFollow[]             @relation("following")
  following         UserFollow[]             @relation("followers")
  collectionFollows CollectionFollow[]
  collaborations    CollectionCollaborator[]
  notifications     Notification[]
  createdWishes     Wish[]                   @relation("createdWishes")
  organizedSantas   SecretSanta[]            @relation("organizedSantas")
  santaMemberships  SecretSantaMember[]      @relation("santaMember")
  santaGifts        SecretSantaMember[]      @relation("santaGiftTo")
  createdAt         DateTime                 @default(now())
  pushTokens        PushToken[]
}

model Collection {
  id            String                   @id @default(cuid())
  name          String
  description   String?
  slug          String                   @unique
  isPublic      Boolean                  @default(false)
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishes        Wish[]
  followers     CollectionFollow[]
  collaborators CollectionCollaborator[]
  santaMembers  SecretSantaMember[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model Wish {
  id               String       @id @default(cuid())
  url              String?
  title            String
  description      String?
  imageUrl         String?
  imageOriginalUrl String?
  price            Float?
  position         Int          @default(0)
  isPriority       Boolean      @default(false)
  collectionId     String
  creatorId        String?
  collection       Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  creator          User?        @relation("createdWishes", fields: [creatorId], references: [id], onDelete: SetNull)
  reservation      Reservation?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Reservation {
  id         String   @id @default(cuid())
  wishId     String   @unique
  reservedBy String
  token      String
  wish       Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model CollectionFollow {
  id           String     @id @default(cuid())
  userId       String
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, collectionId])
}

enum CollaboratorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  COLLABORATION_INVITE
  NEW_FOLLOWER
}

model CollectionCollaborator {
  id           String             @id @default(cuid())
  collectionId String
  userId       String
  status       CollaboratorStatus @default(PENDING)
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([collectionId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  data      Json
  read      Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

enum SecretSantaStatus {
  OPEN
  DRAWN
}

enum SecretSantaMemberStatus {
  INVITED
  JOINED
}

/// A gift exchange: members join (sharing one of their lists), then the organizer draws.
model SecretSanta {
  id          String              @id @default(cuid())
  name        String
  budget      Int?
  date        DateTime?
  inviteCode  String              @unique
  status      SecretSantaStatus   @default(OPEN)
  organizerId String
  organizer   User                @relation("organizedSantas", fields: [organizerId], references: [id], onDelete: Cascade)
  members     SecretSantaMember[]
  drawnAt     DateTime?
  createdAt   DateTime            @default(now())
}

/// One participant. `giftToId` is set by the draw and only ever sent to this member.
model SecretSantaMember {
  id           String                  @id @default(cuid())
  santaId      String
  userId       String
  status       SecretSantaMemberStatus @default(JOINED)
  collectionId String?
  giftToId     String?
  santa        SecretSanta             @relation(fields: [santaId], references: [id], onDelete: Cascade)
  user         User                    @relation("santaMember", fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection?             @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  giftTo       User?                   @relation("santaGiftTo", fields: [giftToId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())

  @@unique([santaId, userId])
  @@index([userId])
}

/// Expo push token of one device (a user can have several phones).
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
