{
  "name": "envly",
  "version": "1.0.0",
  "private": true,
  "description": "Envly — wishlists partagées, surprises préservées. Monorepo : site web (Next.js), app iOS (Expo) et extension Chrome.",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "yarn workspace @envly/web dev",
    "dev:web": "yarn workspace @envly/web dev",
    "dev:mobile": "yarn workspace @envly/mobile start",
    "ios": "yarn workspace @envly/mobile ios",
    "ios:device": "sh apps/mobile/scripts/install-iphone.sh",
    "build": "yarn workspace @envly/web build",
    "start": "yarn workspace @envly/web start",
    "lint": "yarn lint:web && yarn lint:mobile",
    "lint:web": "yarn workspace @envly/web lint",
    "lint:mobile": "yarn workspace @envly/mobile lint",
    "typecheck": "yarn typecheck:web && yarn typecheck:mobile",
    "typecheck:web": "yarn workspace @envly/web typecheck",
    "typecheck:mobile": "yarn workspace @envly/mobile typecheck",
    "check": "yarn typecheck && yarn lint",
    "db:generate": "yarn workspace @envly/web db:generate",
    "db:migrate": "yarn workspace @envly/web db:migrate",
    "db:deploy": "yarn workspace @envly/web db:deploy",
    "db:status": "yarn workspace @envly/web db:status",
    "db:studio": "yarn workspace @envly/web db:studio",
    "extension:zip": "sh apps/extension/zip.sh",
    "brand": "node scripts/brand/render.mjs",
    "scrape:bench": "yarn workspace @envly/web scrape:bench"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  },
  "resolutions": {
    "eslint-config-next/eslint-plugin-react-hooks": "7.0.1"
  }
}
