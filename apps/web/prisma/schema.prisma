generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model User {
  id                String                   @id @default(cuid())
  name              String?
  email             String?                  @unique
  emailVerified     DateTime?
  image             String?
  description       String?
  password          String?
  slug              String?                  @unique
  /// Birthday without year (privacy): friends get a reminder two weeks before.
  birthdayDay       Int?
  birthdayMonth     Int?
  /// When we asked for the birthday (once, skippable): set even if the user declined.
  birthdayAskedAt   DateTime?
  accounts          Account[]
  sessions          Session[]
  collections       Collection[]
  followers         UserFollow[]             @relation("following")
  following         UserFollow[]             @relation("followers")
  collectionFollows CollectionFollow[]
  collaborations    CollectionCollaborator[]
  notifications     Notification[]
  createdWishes     Wish[]                   @relation("createdWishes")
  organizedSantas   SecretSanta[]            @relation("organizedSantas")
  santaMemberships  SecretSantaMember[]      @relation("santaMember")
  santaGifts        SecretSantaMember[]      @relation("santaGiftTo")
  createdAt         DateTime                 @default(now())
  pushTokens        PushToken[]
  blocking          UserBlock[]              @relation("blocker")
  blockedBy         UserBlock[]              @relation("blocked")
  reportsMade       Report[]                 @relation("reporter")
  reportsReceived   Report[]                 @relation("reportedUser")
}

model Collection {
  id            String                   @id @default(cuid())
  name          String
  description   String?
  slug          String                   @unique
  isPublic      Boolean                  @default(false)
  /// Optional occasion (birthday, Christmas, wedding…): countdown on the list and reminders to followers.
  eventDate     DateTime?
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishes        Wish[]
  followers     CollectionFollow[]
  collaborators CollectionCollaborator[]
  santaMembers  SecretSantaMember[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model Wish {
  id               String       @id @default(cuid())
  url              String?
  title            String
  description      String?
  imageUrl         String?
  imageOriginalUrl String?
  /// Pixel size of imageUrl, so clients can reserve the photo's space before it loads (no layout shift).
  imageWidth       Int?
  imageHeight      Int?
  price            Float?
  position         Int          @default(0)
  isPriority       Boolean      @default(false)
  /// Set by the owner once the gift arrived: shown as "Déjà offert" and unlocks the thank-you note.
  receivedAt       DateTime?
  collectionId     String
  creatorId        String?
  collection       Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  creator          User?        @relation("createdWishes", fields: [creatorId], references: [id], onDelete: SetNull)
  reservation      Reservation?
  contributions    Contribution[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Reservation {
  id         String   @id @default(cuid())
  wishId     String   @unique
  reservedBy String
  token      String
  /// Signed-in reserver, only used to deliver the owner's thank-you. Never sent to the owner.
  reserverId String?
  /// Owner's thank-you note, delivered to the reserver without revealing who they are.
  thanks     String?
  thankedAt  DateTime?
  wish       Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([reserverId])
}

/// Group gift: friends pledge an amount towards one wish (no payment, just coordination).
/// Like reservations, never shown to the wish's owner or collaborators.
model Contribution {
  id            String   @id @default(cuid())
  wishId        String
  name          String
  amount        Float
  /// Secret that alone can withdraw the pledge (kept on the contributor's device).
  token         String
  contributorId String?
  wish          Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([wishId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model CollectionFollow {
  id           String     @id @default(cuid())
  userId       String
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, collectionId])
}

enum CollaboratorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  COLLABORATION_INVITE
  NEW_FOLLOWER
  THANKS
}

model CollectionCollaborator {
  id           String             @id @default(cuid())
  collectionId String
  userId       String
  status       CollaboratorStatus @default(PENDING)
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([collectionId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  data      Json
  read      Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

enum SecretSantaStatus {
  OPEN
  DRAWN
}

enum SecretSantaMemberStatus {
  INVITED
  JOINED
}

/// A gift exchange: members join (sharing one of their lists), then the organizer draws.
model SecretSanta {
  id          String              @id @default(cuid())
  name        String
  budget      Int?
  date        DateTime?
  inviteCode  String              @unique
  status      SecretSantaStatus   @default(OPEN)
  organizerId String
  organizer   User                @relation("organizedSantas", fields: [organizerId], references: [id], onDelete: Cascade)
  members     SecretSantaMember[]
  drawnAt     DateTime?
  /// Pairs of user ids that must not give to each other (either way), e.g. couples. Set by the organizer.
  exclusions  Json                @default("[]")
  messages    SecretSantaMessage[]
  createdAt   DateTime            @default(now())
}

/// Anonymous questions between a giver and the person they give to. The recipient never learns `giverId`.
model SecretSantaMessage {
  id          String      @id @default(cuid())
  santaId     String
  giverId     String
  recipientId String
  /// true: written by the giver (anonymous to the recipient); false: the recipient's answer.
  fromGiver   Boolean
  body        String
  santa       SecretSanta @relation(fields: [santaId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([santaId, giverId])
  @@index([santaId, recipientId])
}

/// One participant. `giftToId` is set by the draw and only ever sent to this member.
model SecretSantaMember {
  id           String                  @id @default(cuid())
  santaId      String
  userId       String
  status       SecretSantaMemberStatus @default(JOINED)
  collectionId String?
  giftToId     String?
  santa        SecretSanta             @relation(fields: [santaId], references: [id], onDelete: Cascade)
  user         User                    @relation("santaMember", fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection?             @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  giftTo       User?                   @relation("santaGiftTo", fields: [giftToId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())

  @@unique([santaId, userId])
  @@index([userId])
}

/// Expo push token of one device (a user can have several phones).
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A blocks B: no follow either way, B can't see A in the app (profile, lists, search, feed).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A user reported another user (optionally one of their lists). Also emailed to the team (REPORTS_EMAIL).
model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  collectionId   String?
  reason         String
  details        String?
  reporter       User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([reportedUserId])
}
